---
import Section from "../Section.astro";
import { references } from "@cv";
---

<Section title="References">
    <ul>
      {
        references.map(({ name, job, email }) => (
          <li>
            <article>
              <header>
                <div>
                  <h3>{name}</h3>
                  <p>{job}</p>
                </div>
              </header>
  
              {email && (
                <footer>
                  <p>{email}</p> <!-- Eliminamos el enlace para que solo sea texto -->
                </footer>
              )}
            </article>
          </li>
        ))
      }
    </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article p {
    color: #333;
    font-size: 1rem;
    font-weight: normal;
    margin-top: 4px;
  }

  footer p {
    color: #555; /* Color más tenue para diferenciarlo */
    font-size: 0.95rem;
    font-weight: normal;
  }
</style>
